# SAREEVANTA / NEEL SAREE HOUSE Environment Variables Example
# Copy this file to `.env.local` and populate with actual API keys

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Razorpay Integration (Prepaid Online Payments)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Shiprocket Integration (Logistics & Tracking Webhooks)
SHIPROCKET_EMAIL=your_shiprocket_email_here
SHIPROCKET_PASSWORD=your_shiprocket_password_here
SHIPROCKET_WEBHOOK_SECRET=your_shiprocket_webhook_secret_here
